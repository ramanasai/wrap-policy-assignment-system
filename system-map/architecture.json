  "cards": [
    {
      "dot": "emerald",
      "title": "Resolution",
      "items": [
        "Pure deterministic function of (facts, rules, date, category)",
        "Total tie-break: manual > priority > specificity > created_at > id",
        "Losers are shadowed, not discarded \u2014 deleting a winner resurrects them"
      ]
    },
    {
      "dot": "violet",
      "title": "Reconciliation",
      "items": [
        "Transactional outbox \u2192 reconciler (FOR UPDATE SKIP LOCKED)",
        "Sweeper absorbs missed events; segments re-derive membership",
        "Scheduler fires future-dated transitions with dated keys",
        "Materialized assignments push to provisioning \u2014 eventual and idempotent"
      ]
    },
    {
      "dot": "rose",
      "title": "Auditability",
      "items": [
        "Every decision persists an immutable trace at decision time",
        "Explain answers from the stored snapshot \u2014 never recomputed",
        "Facts and rules are bitemporal: history replays deterministically"
      ]
    }
