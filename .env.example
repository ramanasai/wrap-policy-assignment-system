# ---------------------------------------------------------------------------
# Policy Assignment System — runtime configuration (.env.example)
#
# Copy to .env for local development:  cp .env.example .env
# Host/process environment variables always WIN over .env values, so this
# file is safe to keep in containers too.
#
# .env is gitignored — secrets must never be committed. .env.example is the
# committed template.
# ---------------------------------------------------------------------------

# --- Application environment -------------------------------------------------
# dev | staging | prod. In prod, DATABASE_URL must be set explicitly.
APP_ENV=dev

# --- HTTP API ----------------------------------------------------------------
HTTP_PORT=8080

# --- Database ----------------------------------------------------------------
# libpq/postgres URL form. In prod: set real credentials + sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/pas?sslmode=disable

# --- Logging -----------------------------------------------------------------
# Level: debug | info | warn | error | fatal | panic | disabled
# Format: json (default, machine-parsed) | console (pretty, local dev only)
LOG_LEVEL=debug
LOG_FORMAT=console

# --- Reconciler (event → affected-set recompute worker) ----------------------
# Outbox rows claimed per batch (FOR UPDATE SKIP LOCKED). Must be >= 1.
RECONCILER_BATCH_SIZE=500
# Reconciler safety-net poll when NOTIFY is missed. Must be >= 1ms.
RECONCILER_POLL_INTERVAL=5s

# --- Scheduler (future-dated transitions: tenure gates, "Jan 1" rules) ----
# How often the scheduler checks for transitions that became effective.
SCHEDULER_INTERVAL=1h

# --- Sweeper (expected-vs-actual drift backstop) -----------------------------
# Periodic full-ish reconciliation interval. Must be a positive duration.
SWEEPER_INTERVAL=15m

# --- Resolver read cache -----------------------------------------------------
# In-process LRU entries keyed on (policy version, facts version, date).
RESOLVER_CACHE_SIZE=10000
